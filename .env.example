# Firebase Client (Frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# Firebase Admin (Backend on Render)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# News APIs
NEWSAPI_KEY=
GNEWS_API_KEY=

# Google Sheets (Service Account, optional)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Email (Daily Digest via backend SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@nexora.app

# App
NODE_ENV=development
PORT=3001
VITE_API_URL=http://localhost:3001/api
VITE_APP_URL=http://localhost:5173
ADMIN_EMAIL=
CORS_ORIGIN=http://localhost:5173
CRON_SECRET=local-dev-cron-secret
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
FCM_SERVER_KEY=
APP_VERSION=1.0.0

# Production (Render + Firebase Hosting)
# VITE_API_URL=https://nexora-api.onrender.com/api
# CORS_ORIGIN=https://your-app.web.app,https://your-app.firebaseapp.com
# RENDER_API_URL=https://nexora-api.onrender.com (for GitHub Actions cron)
